        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CinePick Platform Observability",
  "uid": "cinepick-observability-v1",
  "version": 1,
  "weekStart": ""
